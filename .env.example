# Copy this file to .env and fill in the real values from your Supabase project
# (Settings → API). See supabase/schema.sql for the schema these variables talk to,
# and the plan under /root/.claude/plans/ for the full setup walkthrough.

# --- Build-time / browser (Vite inlines these into the public site AND the admin bundle) ---
# Safe to expose publicly: the anon key only has the access granted by Row Level Security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Node-only (used by scripts/sync-games-from-supabase.mjs and scripts/migrate-games-to-supabase.mjs) ---
# NEVER prefix these with VITE_ and never reference them from src/ — the service role key
# bypasses Row Level Security entirely and must never reach a browser bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
